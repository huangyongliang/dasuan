<!--pages/detail/detail.wxml-->
<view class="container" wx:if="{{note}}">
  <view class="note-content">
    <text user-select="true" class="text-content">{{note.content}}</text>
  </view>

  <view class="image-list" wx:if="{{note.images && note.images.length > 0}}">
    <block wx:for="{{note.images}}" wx:key="*this">
      <image src="{{item}}" mode="widthFix" class="note-image" bindtap="previewImage" data-url="{{item}}"></image>
    </block>
  </view>

  <view class="footer-info">
    <text class="time">创建于: {{note.createTime}}</text>
    <text class="status status-{{note.status}}">{{note.status === 'published' ? '已发布' : (note.status === 'pending' ? '审核中' : (note.status === 'pending_delete' ? '删除审核中' : '草稿'))}}</text>
  </view>

  <!-- 评论区 -->
  <view class="comments-section" wx:if="{{note.visibility === 'public'}}">
    <view class="section-title">评论 ({{comments.length}})</view>
    
    <view class="comment-list">
      <block wx:for="{{comments}}" wx:key="_id">
        <view class="comment-item">
          <view class="comment-header">
            <text class="comment-user">大蒜用户</text>
            <text class="comment-time">{{item.createTime}}</text>
          </view>
          <view class="comment-content">{{item.content}}</view>
          <view class="comment-actions" wx:if="{{item._openid === currentOpenId || isAdmin}}">
            <text class="delete-link" bindtap="deleteComment" data-id="{{item._id}}">删除</text>
          </view>
        </view>
      </block>
      <view wx:if="{{comments.length === 0}}" class="no-comments">暂无评论</view>
    </view>

    <view class="comment-input-area">
      <input class="comment-input" placeholder="写下你的评论..." value="{{commentInput}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="submitComment"/>
      <button class="send-btn" bindtap="submitComment" size="mini">发送</button>
    </view>
  </view>
  
  <view class="action-bar" wx:if="{{isMine}}">
    <button class="btn edit-btn" bindtap="gotoEdit" wx:if="{{note.status !== 'pending_delete'}}">编辑</button>
    <button class="btn delete-btn" bindtap="deleteNote" wx:if="{{note.status !== 'pending_delete'}}">删除</button>
    <view class="pending-tip" wx:if="{{note.status === 'pending_delete'}}">删除申请已提交，请等待管理员审核</view>
  </view>
</view>
<view wx:else class="loading-view">
  <text>加载中...</text>
</view>
