/* pages/detail/detail.wxss */
page {
  background-color: #fff;
}

.container {
  padding: 30rpx;
  padding-bottom: 120rpx; /* Space for footer */
}

.note-content {
  font-size: 34rpx;
  line-height: 1.8;
  color: #333;
  margin-bottom: 40rpx;
  white-space: pre-wrap; /* Preserve newlines */
}

.text-content {
    width: 100%;
}

.image-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.note-image {
  width: 100%;
  border-radius: 12rpx;
  background-color: #f8f8f8;
}

.footer-info {
  margin-top: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eee;
}

.status-published {
  background: #e6ffeb;
  color: #07c160;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

/* Comments */
.comments-section {
  margin-top: 60rpx;
  border-top: 1rpx solid #eee;
  padding-top: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.comment-list {
  margin-bottom: 40rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-user {
  font-size: 26rpx;
  color: #576b95; /* WeChat blue */
  font-weight: 500;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.delete-link {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 10rpx;
}

.no-comments {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.comment-input-area {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 20rpx 0;
}

.comment-input {
  flex: 1;
  background: #f8f8f8;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin: 0 !important;
  background: #07c160;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
}

/* Action Bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  z-index: 100;
}

.btn {
  flex: 1;
  border-radius: 44rpx;
  font-weight: 500;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.edit-btn {
  background: #f0f0f0;
  color: #333;
}

.delete-btn {
  background: #ff4d4f;
  color: #fff;
}

.pending-tip {
  width: 100%;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  line-height: 88rpx;
}

.loading-view {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
  font-size: 28rpx;
}
