<!--pages/index/index.wxml-->
<view class="container">
  <!-- 深圳天气 -->
  <view class="tools-container">
    <view class="weather-card">
      <view class="weather-header">
        <view class="weather-title" bindtap="showCityPicker">
          {{currentCity.name}}天气 <text class="dropdown-icon">▼</text>
        </view>
        <view class="weather-date-container" wx:if="{{dateInfo}}">
          <view class="weather-date">{{dateInfo.date}}</view>
          <view class="weather-lunar">{{dateInfo.lunar}}</view>
        </view>
      </view>
      <view class="weather-info" wx:if="{{weather}}">
        <view class="weather-main">
          <view class="weather-temp">{{weather.temperature}}°C</view>
          <view class="weather-condition">{{weather.desc}}</view>
        </view>
        <view class="weather-desc">风速: {{weather.windspeed}} km/h</view>
      </view>
      <view wx:else class="loading-text">
        <text>加载中...</text>
        <view style="font-size: 24rpx; margin-top: 10rpx; color: #ff0000; opacity: 0.8;">(体验版请打开"开发调试"或配置合法域名)</view>
      </view>
    </view>

    <view class="forecast-list" wx:if="{{forecast.length > 0}}">
      <view class="forecast-title">未来七天预报</view>
      <view class="forecast-item" wx:for="{{forecast}}" wx:key="date">
        <view class="forecast-date">{{item.date}} <text class="forecast-week">{{item.week}}</text></view>
        <view class="forecast-condition">{{item.desc}}</view>
        <view class="forecast-temp">{{item.min}}~{{item.max}}°C</view>
      </view>
    </view>
  </view>

  <!-- 自定义底部弹窗城市选择器 -->
  <page-container 
    show="{{showCityPicker}}" 
    round="true" 
    overlay="true" 
    position="bottom" 
    bind:clickoverlay="hideCityPicker"
    custom-style="z-index: 10000;"
  >
    <view class="picker-container">
      <view class="picker-header">
        <view class="picker-btn cancel" bindtap="hideCityPicker">取消</view>
        <view class="picker-title">选择城市</view>
        <view class="picker-btn confirm" bindtap="confirmCity">确定</view>
      </view>
      <picker-view indicator-style="height: 50px;" style="width: 100%; height: 250px;" value="{{[tempCityIndex]}}" bindchange="onPickerChange">
        <picker-view-column>
          <view wx:for="{{cities}}" wx:key="name" style="line-height: 50px; text-align: center;">{{item.name}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </page-container>
</view>
