/* pages/index/index.wxss */
.container {
  padding: 0;
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 80px; /* Space for TabBar */
}

.tab-header {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}

.tab-item {
  margin-right: 40rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
  font-size: 32rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #07c160;
  border-radius: 3rpx;
}

.shout-container {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 80rpx - 90px); /* Adjust height to match input area bottom */
  background: #f6f6f6;
}

.chat-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.chat-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
  background: #eee;
  padding: 10rpx;
  border-radius: 8rpx;
}

.chat-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.chat-item.my-chat {
  flex-direction: row-reverse;
}

.chat-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 80rpx;
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
  border: 2rpx solid #07c160;
  flex-shrink: 0;
}

.chat-bubble {
  max-width: 70%;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
}

.chat-nick {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.my-chat .chat-nick {
  text-align: right;
}

.chat-text {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
  word-break: break-all;
  display: block; /* Ensure text takes up space */
  min-height: 40rpx; /* Ensure visibility */
  border: 1rpx solid #eee; /* Temporary border for debugging visibility */
}

.my-chat .chat-text {
  background: #95ec69;
}

.chat-input-area {
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  position: fixed; /* fix input at bottom above tabbar */
  bottom: 90px; /* Space for Custom TabBar + extra gap */
  left: 0;
  right: 0;
  height: 100rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.03); /* Add shadow for better separation */
}

.chat-input {
  flex: 1;
  height: 70rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  padding: 0 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.note-list {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.note-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.note-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  max-height: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.note-footer {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eee;
  margin-right: 10rpx;
}

.status-published {
  background: #e6ffeb;
  color: #07c160;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.visibility {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f0f0f0;
  color: #666;
  margin-right: auto; /* Push time to right */
}

.author {
  margin-right: auto;
}

.time {
  margin-left: auto;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
}
