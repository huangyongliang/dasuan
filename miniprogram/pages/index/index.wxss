/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
}

.note-list {
  width: 100%;
}

.note-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.note-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  max-height: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.note-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eee;
}

.status-published {
  background: #e6ffeb;
  color: #07c160;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.empty {
  margin-top: 200rpx;
  color: #999;
}
