/* pages/index/index.wxss */
.container {
  padding: 0;
  background-color: #f6f6f6;
  min-height: 100vh;
  padding-bottom: 80px; /* Space for TabBar */
}

.tools-container {
  padding: 30rpx;
}

.weather-card {
  background: linear-gradient(135deg, #74ebd5, #ACB6E5);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
  margin-bottom: 40rpx;
}

.weather-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.weather-title {
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.dropdown-icon {
  font-size: 20rpx;
  margin-left: 10rpx;
  opacity: 0.8;
}

.weather-date-container {
  text-align: right;
}

.weather-date {
  font-size: 28rpx;
  opacity: 0.9;
}

.weather-lunar {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.weather-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.weather-temp {
  font-size: 80rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.weather-condition {
  font-size: 36rpx;
  font-weight: 500;
}

.weather-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

.loading-text {
  font-size: 28rpx;
  opacity: 0.8;
}

.forecast-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.forecast-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  color: #333;
}

.forecast-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.forecast-item:last-child {
  border-bottom: none;
}

.forecast-date {
  color: #333;
  width: 35%; /* 固定宽度确保对齐 */
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.forecast-week {
  margin-left: 10rpx;
  color: #999;
  font-size: 24rpx;
}

.forecast-condition {
  color: #555;
  flex: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.forecast-temp {
  color: #333;
  font-weight: 500;
  width: 30%; /* 固定宽度确保对齐 */
  text-align: right;
  white-space: nowrap;
}

/* 自定义 Picker 样式 */
.picker-container {
  background-color: #fff;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-btn {
  font-size: 30rpx;
  padding: 10rpx;
}

.picker-btn.cancel {
  color: #999;
}

.picker-btn.confirm {
  color: #07c160;
  font-weight: bold;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 500;
}
