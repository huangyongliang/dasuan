<!--pages/editor/editor.wxml-->
<view class="container">
  <!-- 输入区域：占据主要空间，全屏风格 -->
  <view class="input-area">
    <textarea 
      class="content-input" 
      placeholder="在此输入笔记内容..." 
      maxlength="-1" 
      bindinput="onContentInput" 
      value="{{content}}"
      auto-height="{{false}}"
    ></textarea>
    <view class="word-count">{{wordCount}} 字</view>
  </view>

  <!-- 图片区域：底部跟随 -->
  <view class="attachment-area">
    <view class="section-title" wx:if="{{tempImages.length > 0}}">图片附件 ({{tempImages.length}}/9)</view>
    <view class="image-list">
      <block wx:for="{{tempImages}}" wx:key="*this">
        <view class="image-item">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
          <view class="delete-btn" catchtap="removeImage" data-index="{{index}}">×</view>
        </view>
      </block>
      <view class="add-btn" bindtap="chooseImage" wx:if="{{tempImages.length < 9}}">
        <text class="add-icon">+</text>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="footer-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="footer-bar">
    <view class="btn draft" bindtap="save" data-type="draft">存草稿</view>
    <view class="btn publish" bindtap="save" data-type="publish">发布</view>
  </view>
</view>
