/* pages/editor/editor.wxss */
page {
  background-color: #fff;
  height: 100%;
}

.container {
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: stretch; /* 关键修复：覆盖 app.wxss 的 align-items: center，防止宽度塌陷 */
  width: 100vw; /* 显式设置宽度 */
}

.input-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  box-sizing: border-box;
  width: 100%; /* 确保宽度撑满 */
}

.content-input {
  width: 100%;
  flex: 1;
  font-size: 34rpx;
  line-height: 1.6;
  color: #333;
  padding: 0; /* 移除默认 padding */
}

.word-count {
  text-align: right;
  font-size: 26rpx;
  color: #ccc;
  padding: 10rpx 0;
}

.attachment-area {
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
  width: 100%; /* 确保宽度撑满 */
  box-sizing: border-box;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f8f8f8;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-bottom-left-radius: 8rpx;
  text-align: center;
  line-height: 40rpx;
  font-size: 32rpx;
}

.add-btn {
  width: 160rpx;
  height: 160rpx;
  background: #f8f8f8;
  border: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.add-icon {
  font-size: 60rpx;
  color: #ddd;
  font-weight: 300;
  margin-top: -8rpx;
}

.footer-placeholder {
  height: calc(120rpx + 60px + env(safe-area-inset-bottom)); /* 增加占位高度：原有高度 + TabBar 高度 */
  flex-shrink: 0;
}

.footer-bar {
  position: fixed;
  bottom: calc(60px + env(safe-area-inset-bottom)); /* 抬升高度：TabBar 高度 + 安全距离 */
  left: 0;
  right: 0;
  padding: 20rpx 30rpx; /* 移除底部的 safe-area padding，因为已经抬升了 */
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  z-index: 100;
  width: 100%;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 16rpx;
}

.btn:active {
  opacity: 0.8;
}

.draft {
  background: #f5f5f5;
  color: #666;
}

.publish {
  background: #07c160;
  color: #fff;
}
