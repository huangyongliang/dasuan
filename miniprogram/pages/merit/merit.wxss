/* pages/merit/merit.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f6f6f6;
  padding: 0;
}

.header {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  align-items: center; /* 让子元素居中 */
}

.merit-count {
  display: flex;
  flex-direction: column;
  margin-top: 60rpx;
  align-items: center; /* 文字和数字居中对齐 */
}

.merit-count .label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  text-align: center;
}

.merit-count .number {
  font-size: 80rpx; /* 放大本次功德数 */
  font-weight: bold;
  color: #333;
  text-align: center;
  line-height: 1.2;
}

.merit-count .label.total {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.rank-btn {
  background: rgba(0, 0, 0, 0.05);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #333;
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  margin: 0;
  z-index: 10;
}

.wooden-fish-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 200rpx; /* 增加底部间距，整体上移 */
  margin-top: -50rpx; /* 额外上移一点 */
}

/* 简易 CSS 木鱼 */
.wooden-fish {
  width: 300rpx;
  height: 240rpx;
  position: relative;
  transition: transform 0.1s;
}

.wooden-fish.animate {
  transform: scale(0.95);
}

.fish-body {
  width: 100%;
  height: 100%;
  background: #8B4513; /* SaddleBrown */
  border-radius: 50% 50% 40% 40% / 60% 60% 40% 40%;
  position: relative;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.2);
  border: 4rpx solid #5c2e0e;
}

.fish-eye {
  width: 40rpx;
  height: 40rpx;
  background: #333;
  border-radius: 50%;
  position: absolute;
  top: 60rpx;
  left: 60rpx;
  border: 4rpx solid #5c2e0e;
}

.fish-mouth {
  width: 160rpx;
  height: 20rpx;
  background: #333;
  border-radius: 20rpx;
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
}

.fish-handle {
  width: 40rpx;
  height: 60rpx;
  background: #5c2e0e;
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 10rpx;
  z-index: -1;
}

.merit-plus {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  font-weight: bold;
  color: #d4a017;
  opacity: 0;
  pointer-events: none;
}

.merit-plus.float-up {
  animation: floatUp 0.8s ease-out forwards;
}

@keyframes floatUp {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(0.8);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -150%) scale(1.2);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -200%) scale(1);
  }
}

.tip-text {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  position: absolute; /* 绝对定位 */
  bottom: 220rpx; /* 距离底部的位置，根据木鱼位置调整 */
  width: 100%;
}

/* 排行榜样式 */
.rank-modal {
  height: 100%;
  width: 100%; /* 确保占满宽度 */
  background: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box; /* 包含 padding */
}

.rank-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0; /* 防止被压缩 */
}

.rank-title {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx;
}

.rank-list {
  flex: 1;
  padding: 0 30rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%; /* 确保宽度 */
  box-sizing: border-box;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
  width: 100%;
}

.rank-num {
  width: 60rpx;
  font-weight: bold;
  color: #999;
  text-align: center;
  flex-shrink: 0;
}

.rank-num.top-1 { color: #FFD700; font-size: 36rpx; }
.rank-num.top-2 { color: #C0C0C0; font-size: 36rpx; }
.rank-num.top-3 { color: #CD7F32; font-size: 36rpx; }

.rank-user {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
  /* 防止长名字撑开 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx; /* 给右边分数留点距离 */
}

.rank-score {
  font-weight: bold;
  color: #d4a017;
  flex-shrink: 0; /* 防止分数被压缩 */
}

.my-rank {
  padding: 30rpx;
  border-top: 1rpx solid #eee;
  background: #fff;
  display: flex;
  align-items: center;
  /* 增加底部 padding，避开 TabBar (大约 100rpx-120rpx) */
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom) + 120rpx);
  flex-shrink: 0; /* 防止被压缩 */
  width: 100%;
  box-sizing: border-box;
}
