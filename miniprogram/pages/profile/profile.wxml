<!--pages/profile/profile.wxml-->
<view class="container">
  <view class="user-info">
    <view class="avatar-container">
      <open-data type="userAvatarUrl"></open-data>
    </view>
    <view class="nickname">
      <open-data type="userNickName"></open-data>
    </view>
    <view class="openid-row" wx:if="{{openid}}" bindtap="copyOpenId">
      <text class="openid-text">ID: {{openid}}</text>
      <text class="copy-btn">复制</text>
    </view>
    <view class="role-tag" wx:if="{{isAdmin}}">
      管理员
    </view>
  </view>

  <view class="section-title" wx:if="{{isAdmin}}">待审核笔记</view>
  
  <view class="audit-list" wx:if="{{isAdmin}}">
    <block wx:if="{{pendingNotes.length === 0}}">
      <view class="empty-tip">暂无待审核内容</view>
    </block>
    <block wx:else>
      <view class="audit-item" wx:for="{{pendingNotes}}" wx:key="_id" bindtap="auditNote" data-id="{{item._id}}" data-index="{{index}}">
        <view class="audit-content">
          <text wx:if="{{item.status === 'pending_delete'}}" style="color:red; font-weight:bold;">[申请删除] </text>
          {{item.content}}
        </view>
        <view class="audit-time">{{item.createTime}}</view>
        <view class="audit-action">{{item.status === 'pending_delete' ? '审核删除' : '审核发布'}}</view>
      </view>
    </block>
  </view>

  <view class="about-section">
    <text>大蒜助手 v1.0.0</text>
  </view>
</view>
